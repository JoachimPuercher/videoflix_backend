# Copy this file to .env and fill in your own values. Never commit .env.
# Format: KEY=value, no quotes, lists comma separated without spaces.

# DJANGO STANDARD SUPERUSER (created by the entrypoint on first start)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# DJANGO SECRET KEY - READ THE INSTRUCTIONS IN THE README
SECRET_KEY=change-me
# "True" only for local development
DEBUG=True

# Host names without scheme or port
ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins with scheme and port
CSRF_TRUSTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# POSTGRSQL ACCESS (DB_HOST is the Compose service name)
DB_NAME=videoflix
DB_USER=videoflix
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# REDIS CONFIGURATION (REDIS_HOST is the Compose service name)
REDIS_HOST=redis
# Cache location: redis://<host>:<port>/<db index>
REDIS_LOCATION=redis://redis:6379/1
REDIS_PORT=6379
# Database index used by rq
REDIS_DB=0

# EMAIL PROVIDER FOR VERIFY EMAIL AND RESET PASSWORD (e.g. Mailtrap sandbox)
EMAIL_HOST=mailhost
# 587 with TLS, 465 with SSL
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
# Only one of the two may be True
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Videoflix <noreply@example.com>

# Public URLs used in the mails, with scheme and port, without trailing slash
FRONTEND_URL=http://127.0.0.1:5500
BACKEND_URL=http://localhost:8000
